# SaaS Radar — Environment Variables
# Copy this to .env and fill in your values

# ─── App ───────────────────────────────────────────────
NODE_ENV=development
DEMO_MODE=true        # set to false to use real integrations
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://saasradar:password@localhost:5432/saasradar

# ─── Plaid (https://dashboard.plaid.com) ───────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox     # sandbox | production

# ─── Okta ──────────────────────────────────────────────
OKTA_DOMAIN=           # e.g. dev-123456.okta.com
OKTA_API_TOKEN=

# ─── Google Workspace ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/google/callback

# ─── Slack ─────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=    # for alert delivery
